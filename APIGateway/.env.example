# PORT is only for local runs. On Cloud Run the platform injects PORT and it
# must NOT be set manually — a Cloud Run service that ignores the injected
# value fails its startup probe. Leave it out of the Cloud Run env entirely.
PORT=7000

# ─── Upstream service URLs ────────────────────────────────────────────────
#
# Gateway→service traffic is server-to-server. Whether it stays on a private
# network or crosses the public internet decides whether a platform edge can
# throttle it: when all of it leaves from this gateway's single egress IP, one
# IP carries every shopper's requests and edges treat that as abuse. The
# symptom is a plain-text "Too Many Requests" from the gateway while the
# upstream service is idle and its own RateLimit-Remaining is untouched —
# a 429 that no limiter in this codebase produced.
#
#   LOCAL (the values below):
#     USERS_SERVICE_URL=http://localhost:7001
#
#   GOOGLE CLOUD RUN — use each service's https run.app URL. Inter-service
#   calls stay inside Google's network and are not subject to the kind of
#   shared-egress throttling described above. Replace with your own URLs from
#   `gcloud run services list`; these are placeholders:
#     USERS_SERVICE_URL=https://trendy-users-xxxxx.run.app
#     AMAZON_SERVICE_URL=https://trendy-amazon-xxxxx.run.app
#     WALMART_SERVICE_URL=https://trendy-walmart-xxxxx.run.app
#
#   RENDER (still supported) — use the INTERNAL hostnames, not the public
#   https://*.onrender.com ones, or you hit the throttling above. Find each
#   under: Render dashboard → the service → Connect → Internal. Note http,
#   not https: internal traffic is not TLS-terminated, and services must be
#   in the same region.
#     USERS_SERVICE_URL=http://<users-internal-host>:10000
#
# Development:
USERS_SERVICE_URL=http://localhost:7001
AMAZON_SERVICE_URL=http://localhost:8000
WALMART_SERVICE_URL=http://127.0.0.1:8001

# URL of the Auth server. The gateway calls /auth/token/refresh here to renew
# provider (Amazon/Walmart) JWTs. A trailing slash is fine — URLs are joined,
# not concatenated.
#
#   LOCAL:
#     AUTH_SERVER_URL=http://localhost:5000
#
#   GOOGLE CLOUD RUN (placeholder — use your own run.app URL):
#     AUTH_SERVER_URL=https://trendy-auth-xxxxx.run.app
#
#   RENDER — prefer the internal hostname so service-to-service refresh
#   never crosses the public edge. Note http, not https: internal Render
#   traffic is not TLS-terminated.
#     AUTH_SERVER_URL=http://<render-internal-auth-host>:10000
#     (public fallback: https://<auth-service>.onrender.com)
#
# IMPORTANT: the Auth service must stay PUBLICLY reachable on whichever
# platform hosts it. Auth Shield is a separate frontend that calls the SAME
# service on its public URL, so do not convert it into a private/internal-only
# service. Changing this variable only affects where THIS gateway sends its
# refresh traffic.
AUTH_SERVER_URL=http://localhost:5000

# Storefront origin, used only to redirect a rate-limited browser navigation
# (the Google sign-in round-trip) back to a page that can explain itself
# instead of answering a navigation with raw JSON. Optional — defaults to the
# first entry in CORS_ORIGINS below. In production this is the Vercel URL:
#   LOCAL:      CLIENT_URL=http://localhost:3001
#   PRODUCTION: CLIENT_URL=https://<your-storefront>.vercel.app
#               (the storefront stays on Vercel on every platform)
CLIENT_URL=http://localhost:3001

# Comma-separated list of allowed browser origins for CORS.
# Includes the source-branded mock storefronts (Amazon at :8000, Walmart at
# :8001) — after "Continue on X" redirects the buyer to those pages, they
# call back into this gateway to read the checkout intent and place orders,
# so their origins MUST be on the allowlist or the browser blocks the request.
CORS_ORIGINS=http://localhost:3001,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001

# MongoDB connection string. The gateway reads from the `creds` collection
# to inject `productsauthorization` headers when proxying product requests.
# Must point to the same DB as the Users service.
MONGO_CONN=mongodb://localhost:27017/your_db_name

# Asymmetric service-to-service auth (RFC 7523 JWT Bearer profile).
# The gateway signs a short-lived assertion JWT with its PRIVATE key. The
# auth server verifies it with the corresponding PUBLIC key. Compromising
# the auth server's env doesn't let an attacker mint tokens, because they
# can only verify — not sign — with the public key.
#
# Generate a fresh keypair with:
#   node -e "const {generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('PRIVATE:',JSON.stringify(privateKey).replace(/\"/g,''));console.log('PUBLIC:',JSON.stringify(publicKey).replace(/\"/g,''));"
#
# Paste the printed PRIVATE value here (a quoted single-line string with
# literal \n escapes — the gateway un-escapes them at startup) and paste the
# matching PUBLIC value into Auth/server/.env as GATEWAY_PUBLIC_KEY.
GATEWAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...REPLACE-WITH-YOUR-OWN-KEY...AQAB\n-----END PRIVATE KEY-----\n"

# How the gateway identifies itself in the JWT `iss` claim. Auth server
# matches this against its TRUSTED_ISSUERS list.
GATEWAY_ISSUER=apigateway

# Shared secret for service-to-service calls. Used as the x-internal-auth
# header on:
#  - DELETE /internal/token-cache/:apiName (Auth → Gateway invalidation)
#  - POST   /internal/snapshot-tracked     (GH Actions cron → Gateway)
#  - POST   Users /internal/price-drop     (Gateway → Users notifier)
# Must match the INTERNAL_AUTH_SECRET set in Auth/server and Users.
INTERNAL_AUTH_SECRET=replace-with-a-long-random-string

# Rate-limit tunables (optional — sensible defaults if omitted).
# Per-IP request budget across all gateway routes (default 120/min).
RATE_LIMIT_PER_MIN=120
# Per-IP request budget for /api/v1/user/auth/* and /api/v1/user/recovery/*
# (default 30 per 15 min).
AUTH_RATE_LIMIT_PER_15M=30

# ─── Which platform is this running on? ───────────────────────────────────
#
# Selects how the caller's IP is determined, which is what every rate-limit
# bucket is keyed on. Set it per deployment; it is the one networking knob
# that must be right.
#
#   local       no forwarded headers trusted (trust proxy = loopback)
#   cloud-run   one trusted hop — Cloud Run's front end controls the last
#               X-Forwarded-For entry. No client header is trusted.
#   render      two trusted hops (Cloudflare edge + Render's router), and
#               CF-Connecting-IP is trusted because Cloudflare overwrites it.
#
# Production default when unset is `cloud-run`, the conservative option: it
# trusts no caller-supplied header. If that default is wrong for a Render
# deployment the cost is coarser buckets — not a bypass. The reverse default
# would trust a forgeable CF-Connecting-IP anywhere Cloudflare is absent, so
# Render deployments MUST set this explicitly.
#
#   LOCAL:     DEPLOYMENT_PLATFORM=local       (or leave unset)
#   CLOUD RUN: DEPLOYMENT_PLATFORM=cloud-run
#   RENDER:    DEPLOYMENT_PLATFORM=render
DEPLOYMENT_PLATFORM=local

# Escape hatch for a topology with no preset above. A hop count, `loopback`,
# a CIDR, or a comma-separated list. NEVER `true` — that would let any caller
# spoof X-Forwarded-For; the code refuses it and warns.
#
# The `cloud-run` preset assumes ONE appending proxy, which is correct for
# traffic arriving directly at a *.run.app URL. Putting an external HTTP(S)
# Load Balancer, Cloud Armor or a CDN in front adds a hop — set
# TRUST_PROXY=2 on that service if you do.
# TRUST_PROXY=

# How long (ms) before the gateway re-snapshots a product's price on a
# product-detail read. Lower = more granular price-history chart, more
# DB writes. Higher = sparser history, cheaper writes. 6h default keeps
# storage bounded even for hot products while still capturing intraday
# moves.
SNAPSHOT_STALE_MS=21600000

# ─── Provider token lifecycle (all optional; defaults shown) ───────────────
# The gateway decodes each provider JWT's `exp` and renews it before it
# lapses, instead of waiting for Amazon/Walmart to reject it. Normal expiry
# should never require re-running the admin authorization flow.

# Renew once a provider token is this close to expiring. The token is still
# served while the renewal runs in the background, so shoppers never wait.
TOKEN_REFRESH_AHEAD_SECONDS=300

# How many times to try /auth/token/refresh before giving up for one cycle.
# Only transient failures (429, 502, 503, 504, timeouts, network errors) are
# retried; 400/401/403 mean the request itself is wrong and stop immediately.
REFRESH_MAX_ATTEMPTS=3

# Per-attempt HTTP timeout, so a hung auth service can't pin a shopper
# request open. Timeouts count as transient and are retried.
REFRESH_REQUEST_TIMEOUT_MS=10000

# Ceiling on any single wait between attempts, including a server-supplied
# Retry-After. Stops an "Retry-After: 3600" from stalling a request.
REFRESH_MAX_RETRY_DELAY_MS=30000

# After attempts are exhausted, stop retrying for this long. Prevents a
# failing auth service from being hammered by every shopper request.
REFRESH_COOLDOWN_MS=30000

# How long a provider token may be served from memory without re-reading
# MongoDB. Expiry is still checked on every read — this only bounds DB
# chatter, it can never cause a near-expired token to be served.
TOKEN_CACHE_TTL_MS=60000
