# PORT is only for local runs. On Cloud Run the platform injects PORT and it
# must NOT be set manually. The Dockerfile's gunicorn entrypoint already
# binds 0.0.0.0:${PORT}, which is what Cloud Run requires.
PORT=8001

# MongoDB connection string (read as os.getenv("MONGO_CONN")).
# Walmart owns its own database — products, orders, customers, addresses,
# payments are isolated from the storefront/aggregator data.
MONGO_CONN=mongodb://localhost:27017/walmart

# Comma-separated list of allowed browser origins for CORS.
# Must include this service's own origin because the checkout page hosted
# here POSTs to /payments/create-intent and /orders/place.
CORS_ORIGINS=http://localhost:3001,http://localhost:8001,http://127.0.0.1:8001

# Secret used to verify the productsauthorization JWT.
# Read as os.getenv("SECRET") in Walmart/Middlewares/authorization.py. The same
# variable name is used in Amazon. Both must equal Auth/server's
# JWT_PROVIDER_SECRET (or its fallback JWT_SECRET) — that's the secret used
# to sign the token in Auth/server/utils/tokens.js.
SECRET=replace-with-a-long-random-string

# Auth server used for active-jti introspection. The middleware calls
# GET ${AUTH_SERVER_URL}/auth/token/active/:clientId to learn the currently-
# active jti for an incoming token's client_id and reject tokens whose jti
# doesn't match (i.e. tokens superseded by a more recent re-auth/refresh).
AUTH_SERVER_URL=http://localhost:5000

# Gateway URL used by Walmart checkout to fetch trusted referral details and
# mark checkout intents completed after an order is placed.
#   LOCAL:     http://localhost:7000   (Docker: http://gateway:7000)
#   CLOUD RUN: https://trendy-gateway-xxxxx.run.app
#   RENDER:    https://<your-gateway>.onrender.com
TT_GATEWAY_URL=http://localhost:7000

# Storefront URL injected into the branded checkout page so its "back to
# Trendy Treasures" link works. Read by static/checkout.js via
# window.TRENDY_TREASURES_URL. The storefront stays on Vercel on every
# platform, so this does not change when the backend moves.
#   LOCAL:      http://localhost:3001
#   PRODUCTION: https://<your-storefront>.vercel.app
TRENDY_TREASURES_URL=http://localhost:3001

# Shared secret for service-to-service calls (sent as x-internal-auth header).
# Must match Auth/server's INTERNAL_AUTH_SECRET. Without it, the auth server
# rejects introspection requests with 403 and superseded-token detection
# silently breaks.
INTERNAL_AUTH_SECRET=replace-with-a-long-random-string

# How long (ms) to cache an active_jti lookup per client_id. Lower = faster
# revocation propagation, higher = fewer auth-server hits. 30s default.
AUTH_INTROSPECT_CACHE_TTL_MS=30000

# Rate-limit tunables (optional — sensible defaults if omitted).
# Per-IP request budget across all Walmart routes (default 120/min).
RATE_LIMIT_PER_MIN=120
# Per-IP budget for /payments/* (default 20/min). Tighter because each call
# round-trips Stripe and costs money on abuse.
PAYMENTS_RATE_LIMIT_PER_MIN=20

# ─── Which platform is this running on? ───────────────────────────────────
#
# Selects the ProxyFix hop count and how the caller's IP is determined, which
# is what every Flask-Limiter bucket is keyed on.
#
#   local       x_for=0 — no forwarded headers trusted
#   cloud-run   x_for=1 — Cloud Run's front end controls the last
#               X-Forwarded-For entry. No client header is trusted.
#   render      x_for=2 (Cloudflare edge + Render's router), and
#               CF-Connecting-IP is trusted because Cloudflare overwrites it.
#
# Separately, and on every platform: when the APIGateway proxies a request it
# forwards `x-real-client-ip` alongside `x-internal-auth`. This service
# accepts that IP ONLY when the secret matches (constant-time compare), so
# the per-shopper identity survives proxying without letting a direct caller
# forge someone else's bucket.
#
# Production default when unset is `cloud-run`, the conservative option.
# Render deployments MUST set this explicitly.
#
#   LOCAL:     DEPLOYMENT_PLATFORM=local       (or leave unset)
#   CLOUD RUN: DEPLOYMENT_PLATFORM=cloud-run
#   RENDER:    DEPLOYMENT_PLATFORM=render
DEPLOYMENT_PLATFORM=local

# Escape hatch for a topology with no preset above. ProxyFix only accepts a
# hop count, so a non-numeric value is ignored (and logged) rather than
# guessed at.
# TRUST_PROXY=

# In production Flask-Talisman issues HSTS and force-redirects HTTP→HTTPS.
# Set FLASK_ENV=production (or NODE_ENV=production) to enable both.
# FLASK_ENV=production

# Stripe API keys (test mode). Get them from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
